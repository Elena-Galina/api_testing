        {
          "name": "Add a new pet to the store",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "//------- Проверка статус кода 200\r",
                  "pm.test(\"Status code is 200. Successful\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "//---------- Проверка headers Content-Type: application/json\r",
                  "pm.test(\"headers correct: Content-Type: application/json\", () => {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
                  "        .to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "//---------- Проверка свойств и типов данных полей\r",
                  "const jsonData = pm.response.json();\r",
                  "pm.test(\"The response test data type is correct\", () => {\r",
                  "    pm.expect(jsonData).to.be.an(\"object\");\r",
                  "\r",
                  "    // базовые поля\r",
                  "    pm.expect(jsonData).to.have.property(\"id\");\r",
                  "    pm.expect(jsonData.id).to.be.a(\"number\");\r",
                  "\r",
                  "    pm.expect(jsonData).to.have.property(\"name\");\r",
                  "    pm.expect(jsonData.name).to.be.a(\"string\");\r",
                  "\r",
                  "    pm.expect(jsonData).to.have.property(\"status\");\r",
                  "    pm.expect(jsonData.status).to.be.a(\"string\");\r",
                  "\r",
                  "    // category\r",
                  "    pm.expect(jsonData.category).to.be.an(\"object\");\r",
                  "    pm.expect(jsonData.category.id).to.be.a(\"number\");\r",
                  "    pm.expect(jsonData.category.name).to.be.a(\"string\");\r",
                  "\r",
                  "    // photoUrls\r",
                  "    pm.expect(jsonData.photoUrls).to.be.an(\"array\");\r",
                  "    pm.expect(jsonData.photoUrls[0]).to.be.a(\"string\");\r",
                  "\r",
                  "    // tags\r",
                  "    pm.expect(jsonData.tags).to.be.an(\"array\");\r",
                  "    if (jsonData.tags.length > 0) {\r",
                  "        pm.expect(jsonData.tags[0].id).to.be.a(\"number\");\r",
                  "        pm.expect(jsonData.tags[0].name).to.be.a(\"string\");\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "//---------- Проверка данных в сравнении с запросом (через eql)\r",
                  "const res = pm.response.json();\r",
                  "const req = JSON.parse(pm.request.body.raw);\r",
                  "\r",
                  "// Функция сравнения с request\r",
                  "function checkEqual(res, req, field) {\r",
                  "    pm.expect(res[field]).to.eql(req[field]);\r",
                  "}\r",
                  "\r",
                  "// Функция для массивов\r",
                  "function checkArrayDeepEqual(resArr, reqArr) {\r",
                  "  //  pm.expect(resArr).to.have.deep.members(reqArr);\r",
                  "    pm.expect(resArr).to.deep.eql(reqArr);\r",
                  "}\r",
                  "\r",
                  "pm.test(\"Введенные данные соответствуют запросу\", () => {\r",
                  "    checkEqual(res, req, \"id\"); \r",
                  "    checkEqual(res, req, \"name\"); \r",
                  "    checkEqual(res, req, \"status\"); \r",
                  "    //  pm.expect(res.name).to.eql(req.name);\r",
                  "    //  pm.expect(res.status).to.eql(req.status);\r",
                  "      \r",
                  "    pm.expect(res.category).to.deep.eql(req.category);\r",
                  "   // checkEqual(res.category, req.category, \"id\");\r",
                  "   // checkEqual(res.category, req.category, \"name\");\r",
                  "\r",
                  "    checkArrayDeepEqual(res.photoUrls, req.photoUrls);\r",
                  "    checkArrayDeepEqual(res.tags, req.tags);\r",
                  "    // pm.expect(res.photoUrls).to.deep.eql(req.photoUrls);\r",
                  "    // pm.expect(res.tags).to.deep.eql(req.tags);\r",
                  "});\r",
                  "\r",
                  "//---------- Логируем время ответа (Открой Postman Console: Windows: Ctrl + Alt + C)\r",
                  "const time = pm.response.responseTime;\r",
                  "\r",
                  "pm.test(\"Response time OK, below 800\", () => {\r",
                  "    console.log(`Response time: ${time} ms`);\r",
                  "    pm.expect(time).to.be.below(800);\r",
                  " //   console.log(\"Full response:\", JSON.stringify(pm.response.json(), null, 2));  // -Выводим ответ в консоль\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
